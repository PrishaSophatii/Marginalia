# Your site's public address, used for links, the sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://www.example.com

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From AdSense once you're approved (leave empty to show no ads)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=
NEXT_PUBLIC_ADSENSE_SLOT_LIBRARY=

# Google Search Console verification code (the content="..." part of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
